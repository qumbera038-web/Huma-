(import os, zipfile) Tj
T* () Tj
T* (def build_single_file_html\(\):) Tj
T* (    dist_dir = 'dist') Tj
T* (    index_html = open\(os.path.join\(dist_dir, 'index.html'\)\).read\(\)) Tj
T* (    ) Tj
T* (    # 1. Inline all compiled Tailwind CSS styles) Tj
T* (    css_files = [f for f in os.listdir\(os.path.join\(dist_dir, 'assets'\)\) if f.endswith\('.css'\)]) Tj
T* (    for css in css_files:) Tj
T* (        css_content = open\(os.path.join\(dist_dir, 'assets', css\)\).read\(\)) Tj
T* (        index_html = index_html.replace\(f'<link rel="stylesheet" crossorigin href="/assets/{css}">', ) Tj
T* (                                       f'<style>{css_content}</style>'\)) Tj
T* (                                       ) Tj
T* (    # 2. Output to standalone file \(Runs on any phone or laptop without internet\)) Tj
T* (    open\('public/haider_sanitary_pos_single_file.html', 'w'\).write\(index_html\)) Tj
T* (    print\("Single File Offline App generated successfully!"\)) Tj
ET
