(export const saveStoredProducts = \(products: Product[]\) => {) Tj
T* (  localStorage.setItem\("haider_pos_products", JSON.stringify\(products\)\);) Tj
T* (};) Tj
T* () Tj
T* (export const exportAllDataBackup = \(\) => {) Tj
T* (  const backup = {) Tj
T* (    version: "2.0",) Tj
