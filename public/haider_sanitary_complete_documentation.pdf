(const [deferredPrompt, setDeferredPrompt] = useState<any>\(null\);) Tj
T* () Tj
T* (useEffect\(\(\) => {) Tj
T* (  const handleBeforeInstallPrompt = \(e: Event\) => {) Tj
T* (    e.preventDefault\(\); // Prevent default banner, enable custom 1-click install button) Tj
T* (    setDeferredPrompt\(e\);) Tj
T* (  };) Tj
T* (  window.addEventListener\("beforeinstallprompt", handleBeforeInstallPrompt\);) Tj
T* (  return \(\) => window.removeEventListener\("beforeinstallprompt", handleBeforeInstallPrompt\);) Tj
T* (}, []\);) Tj
